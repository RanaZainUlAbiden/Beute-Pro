# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/beute_pro

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Exchange Rate API (Auto-fetch)
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest
BASE_CURRENCY=PKR
TARGET_CURRENCIES=USD,AED

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional R2 storage: leave R2_ACCESS_KEY_ID unset to use local uploads/.
# When enabling R2, supply all five values; never commit real credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=beute-pro-media
R2_PUBLIC_URL=https://cdn.beutepro.com
